{
  "name": "torrentdock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "npm run build && electron .",
    "electron:start": "electron .",
    "electron:smoke": "npm run build && electron . --smoke",
    "electron:media-probe": "npm run build && electron . --media-probe",
    "electron:playback-probe": "electron . --playback-probe",
    "electron:playback-probe:http": "electron . --playback-probe --http",
    "electron:rqbit-stream-probe": "electron . --rqbit-stream-probe",
    "electron:verify-runtime": "node scripts/verify-electron-runtime.mjs",
    "electron:verify-rqbit-stream": "npm run build && electron . --rqbit-stream-probe",
    "electron:verify-media": "npm run build && npm run electron:verify-runtime && node scripts/verify-electron-media.mjs",
    "electron:build:win": "npm run electron:verify-media && electron-builder --win nsis portable --x64",
    "electron:build:mac": "npm run electron:verify-media && electron-builder --mac dmg zip --universal",
    "electron:build:linux": "npm run electron:verify-media && electron-builder --linux AppImage deb --x64",
    "check:all": "npm run electron:verify-media && npm audit",
    "preview": "vite preview",
    "sidecar:prepare": "node scripts/prepare-rqbit-sidecar.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "video.js": "^8.23.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "app.torrentdock.desktop",
    "productName": "TorrentDock",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "electron-ffmpeg-runtime.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/binaries",
        "to": "binaries",
        "filter": [
          "rqbit-*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
